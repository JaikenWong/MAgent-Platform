# ───────── MAgent-Platform 环境变量 ─────────
# 复制为 .env 后填写真实值

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=magent
POSTGRES_USER=magent
POSTGRES_PASSWORD=magent_dev_pwd

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Backend (Spring Boot) =====
BACKEND_PORT=8080
# JWT 签名密钥, 至少 32 字节
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# AES 字段加密密钥 (用于 Dify api_key / 飞书 app_secret), 16/24/32 字节
CRYPTO_AES_KEY=0123456789abcdef0123456789abcdef
# 默认管理员 (首次启动 seed)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ===== Dify (默认地址, 单个 Agent 可覆盖) =====
DIFY_BASE_URL=http://dify.local:3001/v1

# ===== LLM (Orchestrator 意图解析用, OpenAI 兼容) =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 飞书默认 (单个 Bot 可覆盖) =====
FEISHU_BASE_URL=https://open.feishu.cn/openapis

# ===== Frontend =====
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1

# ===== Traefik (可选, 反代) =====
TRAEFIK_DASHBOARD_PORT=8081
APP_DOMAIN=magent.local

# ===== 平台公开基址 (暴露给 A2A 客户端 / 飞书回调用) =====
MAGENT_PUBLIC_BASE_URL=http://localhost:8080